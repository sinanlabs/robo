---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import EvidenceList from '../components/EvidenceList.astro';
import LatencyCard from '../components/LatencyCard.astro';
import CompatMatrix from '../components/CompatMatrix.astro';
import ActivityCard from '../components/ActivityCard.astro';
import { getCollection } from 'astro:content';
import { t, href, type Lang } from '../lib/i18n';
import { MODEL_REQUIRED, pendingOf, fmtParams } from '../lib/data';
import { isPending } from '../lib/evidence';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const en = lang === 'en';
const m = (await getCollection('models')).map((x) => x.data).find((x) => x.id === id)!;
const embs = (await getCollection('embodiments')).map((e) => e.data);
const compat = (await getCollection('compat')).map((c) => c.data).filter((c) => c.model_id === id);
const hw = (await getCollection('hardware')).map((h) => h.data);
const meas = (await getCollection('measurements')).map((x) => x.data).filter((x) => x.model_id === id);
const act = (await getCollection('activity').catch(() => [])).map((x: any) => x.data).find((x: any) => x.id === id);
const recipe = (await getCollection('recipes').catch(() => [])).map((x: any) => x.data).find((x: any) => x.model_id === id);
const notRep = (((await getCollection('recipes_meta').catch(() => [])).map((x: any) => x.data)[0] || {}).not_reproduced || []).find((x: any) => x.model_id === id);
const myScores = (await getCollection('scores').catch(() => [])).map((x: any) => x.data).filter((x: any) => x.model_id === id);
const benchDefs = Object.fromEntries((await getCollection('benchmarks').catch(() => [])).map((x: any) => [x.data.id, x.data]));
const myRepro = (await getCollection('repro').catch(() => [])).map((x: any) => x.data).filter((x: any) => x.model_id === id);
const p = pendingOf(m as any, MODEL_REQUIRED);
const dates = Array.from(new Set(m.evidence.map((e) => e.fetched))).sort();
---
<Base lang={lang} title={`${m.name} · Sinan Robo`} desc={`${m.name} · ${m.org} · ${en ? 'license, weights, compatibility, latency and cost, with sources' : '许可证、权重、适配本体、延迟与成本，字字有来源'}`} active="models" path={'/models/' + m.id} crumbs={[{ label: t(lang, 'nav.models'), href: href(lang, '/models') }, { label: m.name }]}>
  <div class="rise" style="--i:0;display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;margin-bottom:16px">
    <div><div class="eyebrow" style="color:var(--robo-deep);opacity:1">{m.org}</div><h1 style="font-size:30px;margin-top:6px">{m.name}</h1></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-left:auto">
      {m.params_b != null ? <span class="pill none mono">{fmtParams(m.params_b)}</span> : null}
      {m.commercial_ok === true ? <span class="pill yes">{t(lang, 'badge.commercial_yes')}</span> : m.commercial_ok === false ? <span class="pill no">{t(lang, 'badge.commercial_no')}</span> : <span class="pill pending">{t(lang, 'badge.commercial_unknown')}</span>}
      <span class="pill none mono">{p.ok}/{p.total} {en ? 'verified' : '已核实'}</span>
    </div>
  </div>
  {p.pending > 0 && <div class="notice rise" style="--i:1;margin-bottom:14px">{en ? `${p.pending} of ${p.total} required fields are unverified. They are shown as badges, not filled with defaults. Sources for verified fields are listed below.` : `${p.total} 个必填字段里有 ${p.pending} 个待核实，前台用徽标标出、不用默认值填空。已核实字段的来源列在下方。`}</div>}

  <div class="grid2" style="margin-top:0">
    <section class="card pad rise" style="--i:2">
      <h2 class="sec">{en ? 'Facts' : '基本事实'}</h2>
      <dl class="kv" style="margin-top:14px">
        <Field lang={lang} field="release_date" value={m.release_date} evidence={m.evidence} />
        <Field lang={lang} field="params_b" value={m.params_b} evidence={m.evidence} kind="number" unit="B" />
        <Field lang={lang} field="arch_type" value={m.arch_type} evidence={m.evidence} kind="arch" />
        <Field lang={lang} field="license" value={m.license} evidence={m.evidence} />
        <Field lang={lang} field="commercial_ok" value={m.commercial_ok} evidence={m.evidence} kind="bool" />
        <Field lang={lang} field="weights_url" value={m.weights_url} evidence={m.evidence} kind="url" />
        <Field lang={lang} field="code_url" value={m.code_url} evidence={m.evidence} kind="url" />
        <Field lang={lang} field="paper_url" value={m.paper_url} evidence={m.evidence} kind="url" />
        <Field lang={lang} field="modalities_in" value={m.modalities_in} evidence={m.evidence} kind="list" />
        <Field lang={lang} field="action_space" value={m.action_space} evidence={m.evidence} />
        <Field lang={lang} field="cross_embodiment" value={m.cross_embodiment} evidence={m.evidence} />
        <Field lang={lang} field="pretrain_hours" value={m.pretrain_hours} evidence={m.evidence} kind="number" unit="h" />
        <Field lang={lang} field="target_embodiments" value={m.target_embodiments} evidence={m.evidence} kind="form" />
      </dl>
      {m.arch_notes && !isPending(m.arch_notes) && <div class="callout" style="margin-top:14px"><b>{t(lang, 'field.arch_type')}</b> · {m.arch_notes}</div>}
      <EvidenceList lang={lang} evidence={m.evidence} open={true} />
    </section>
    <div style="display:grid;gap:16px;align-content:start">
      <div class="rise" style="--i:2.5"><ActivityCard lang={lang} a={act} codeUrl={m.code_url} weightsUrl={m.weights_url} /></div>
      <section class="card pad rise" style="--i:2.7">
        <h2 class="sec">{en ? 'Public benchmark scores' : '公开基准分数'}</h2>
        {myScores.length ? <div><p class="sub" style="margin-top:4px">{en ? 'As printed in the source; protocols differ between papers. Full table with notes on the benchmarks page.' : '照抄来源；各论文协议不同。带备注的完整表见基准分数页。'}</p>
          <div class="tablewrap" style="margin-top:8px"><table><thead><tr><th>{en ? 'Benchmark' : '基准'}</th><th>{en ? 'Subset' : '子集'}</th><th class="num">{en ? 'Score' : '分数'}</th><th>{en ? 'Source' : '来源'}</th></tr></thead>
          <tbody>{[...myScores].sort((a: any, b: any) => (a.benchmark_id + (a.subset || '')).localeCompare(b.benchmark_id + (b.subset || '')) || (a.variant || '').localeCompare(b.variant || '')).slice(0, 14).map((s: any) => <tr><td>{benchDefs[s.benchmark_id]?.[en ? 'name_en' : 'name'] || benchDefs[s.benchmark_id]?.name || s.benchmark_name || s.benchmark_id}{s.variant ? <span class="pill none mono" style="margin-left:6px">{s.variant}</span> : null}</td><td class="mono sub">{s.subset || '—'}</td><td class="num mono">{Math.round(s.score * 10) / 10}{s.unit === '%' ? '' : ' ' + s.unit}</td><td class="sub" style="max-width:220px"><a href={s.source_url} rel="noopener">{s.source_type === 'paper' ? (en ? 'paper' : '论文') : s.source_type === 'official' ? (en ? 'official' : '官方') : (en ? 'third-party' : '第三方')}</a>{s.source_ref ? ' · ' + s.source_ref : ''}</td></tr>)}</tbody></table></div>
          <a class="btn" href={href(lang, '/benchmarks')} style="margin-top:10px">{myScores.length > 14 ? (en ? `All ${myScores.length} scores with notes →` : `全部 ${myScores.length} 条分数与备注 →`) : (en ? 'All benchmarks →' : '全部基准 →')}</a></div>
        : <div class="callout" style="margin-top:10px">{en ? 'No public benchmark score recorded for this model yet (we only copy numbers printed in a paper, README or model card).' : '还没有记录这个模型的公开基准分数（我们只抄论文、README 或模型卡里印出来的数字）。'}</div>}
      </section>
      <section class="card pad rise" style="--i:3">
        <h2 class="sec">{en ? 'Deployment recipe' : '部署配方'}</h2>
        {recipe ? <div style="margin-top:10px"><p class="sub">{en ? `Environment, weights, run command and the pitfalls we hit, exactly as executed on rented GPUs (venv ${recipe.env}, ${(recipe.weights || []).reduce((a: number, w: any) => a + (w.size_gb || 0), 0).toFixed(1)} GB of weights, ${(recipe.pitfalls || []).length} pitfalls).` : `环境、权重、运行命令和我们踩过的坑，与在租用 GPU 上实际执行的一字不差（venv ${recipe.env}，权重 ${(recipe.weights || []).reduce((a: number, w: any) => a + (w.size_gb || 0), 0).toFixed(1)} GB，${(recipe.pitfalls || []).length} 个坑位）。`}</p><a class="btn" href={href(lang, '/recipes/' + m.id)} style="margin-top:10px">{en ? 'Open recipe →' : '查看配方 →'}</a></div>
        : notRep ? <div class="callout" style="margin-top:10px"><b>{en ? 'Not reproduced yet' : '尚未复现'}</b> · {notRep[en ? 'en' : 'zh']}</div>
        : <div class="callout" style="margin-top:10px">{en ? 'No recipe yet. We publish only steps that actually ran on a rented GPU with a measured latency; this model has not been through that yet.' : '还没有配方。我们只发布在租用 GPU 上真正跑通、带实测延迟的步骤；这个模型还没轮到。'}</div>}
      </section>
      <section class="card pad rise" style="--i:4">
        <h2 class="sec">{en ? 'Record history' : '记录历史'}</h2>
        <div class="feed" style="margin-top:6px">{dates.length ? dates.map((d) => <div class="row"><div class="t">{d}</div><div>{en ? 'Sources fetched' : '来源抓取'}<div class="dim">{m.evidence.filter((e) => e.fetched === d).map((e) => e.field).join(' · ')}</div></div></div>) : <div class="row"><div class="t">—</div><div class="dim">{t(lang, 'evidence.empty')}</div></div>}</div>
      </section>
    </div>
  </div>

  <div class="rise" style="margin-top:16px;--i:4.5"><LatencyCard lang={lang} hardware={hw as any} measurements={meas as any} /></div>

  <section class="card pad rise" style="margin-top:16px;--i:5">
    <h2 class="sec">{en ? 'Compatibility' : '适配本体'}</h2>
    <p class="lead" style="margin-bottom:10px">{en ? 'Colored only where we hold evidence. An amber dot means the vendor declares this form as a target; that is a claim, not a verified compatibility.' : '只有有证据的格子才上色。橙点表示厂商声明的目标形态，那是声明，不是核实过的适配。'}</p>
    <CompatMatrix lang={lang} models={[m]} embodiments={embs} compat={compat} />
  </section>

  <section class="card pad rise" style="margin-top:16px;--i:6">
    <h2 class="sec">{en ? 'Reproduction records' : '复现记录'}</h2>
    <p class="lead" style="margin-bottom:10px">{en ? 'Did this model run on your robot? Report it with a link (log, video or repo). Records are reviewed by the maintainers; a verified “works” or “works after fine-tuning” upgrades the matrix cell to “community verified” with your link as evidence. Anonymous is fine; nothing but the fields below is stored.' : '这个模型在你的机器人上跑起来了吗？报一条，附链接（日志、视频或仓库）。记录由维护者核验；核验通过的“跑通”或“微调后跑通”会把矩阵格子升为“社区复现”，你的链接就是证据。可匿名；只存下面这几个字段。'}</p>
    {myRepro.length ? <div class="tablewrap" style="margin-bottom:12px"><table><thead><tr><th>{en ? 'Body' : '本体'}</th><th>{en ? 'Outcome' : '结果'}</th><th>{en ? 'Setting' : '真机/仿真'}</th><th>{en ? 'Evidence' : '证据'}</th><th>{en ? 'Verified' : '核验'}</th></tr></thead>
      <tbody>{myRepro.map((r: any) => <tr><td><a href={href(lang, '/embodiments/' + r.embodiment_id)}>{embs.find((e) => e.id === r.embodiment_id)?.name || r.embodiment_id}</a></td><td>{r.outcome === 'works' ? (en ? 'works' : '跑通') : r.outcome === 'finetune' ? (en ? 'works after fine-tuning' : '微调后跑通') : (en ? 'did not run' : '未跑通')}</td><td class="sub">{r.setting === 'real' ? (en ? 'real robot' : '真机') : r.setting === 'sim' ? (en ? 'simulation' : '仿真') : '—'}</td><td>{r.evidence_url ? <a href={r.evidence_url} rel="noopener">{en ? 'link' : '链接'}</a> : <span class="sub">{(r.note || '').slice(0, 60)}</span>}</td><td class="mono dim">{r.verified_at}</td></tr>)}</tbody></table></div>
      : <p class="sub" style="margin-bottom:10px">{en ? 'No verified record yet for this model.' : '这个模型还没有核验通过的复现记录。'}</p>}
    <form id="rf" class="rf" onsubmit="return false">
      <select name="embodiment_id" required><option value="">{en ? 'Body…' : '选本体…'}</option>{embs.map((e) => <option value={e.id}>{e.name} · {e.vendor}</option>)}</select>
      <select name="outcome" required><option value="">{en ? 'Outcome…' : '结果…'}</option><option value="works">{en ? 'works out of the box' : '直接跑通'}</option><option value="finetune">{en ? 'works after fine-tuning' : '微调后跑通'}</option><option value="failed">{en ? 'did not run' : '没跑通'}</option></select>
      <select name="setting"><option value="">{en ? 'Real / sim…' : '真机 / 仿真…'}</option><option value="real">{en ? 'real robot' : '真机'}</option><option value="sim">{en ? 'simulation' : '仿真'}</option></select>
      <input name="evidence_url" type="url" placeholder={en ? 'Evidence link (log / video / repo)' : '证据链接（日志 / 视频 / 仓库）'}>
      <input name="note" maxlength="500" placeholder={en ? 'One line: setup, what happened' : '一句话：环境、发生了什么'}>
      <button class="btn a" type="submit">{en ? 'Submit for review' : '提交待核验'}</button>
      <span class="sub" id="rmsg"></span>
    </form>
    <script id="rmeta" type="application/json" set:html={JSON.stringify({ model_id: m.id, ok: en ? 'Submitted. It shows here after review.' : '已提交，核验通过后会出现在这里。', fail: en ? 'Not sent: ' : '未发送：', need: en ? 'Give a link or a note.' : '请给一个链接或写一句说明。' })}></script>
    <script>
      const M = JSON.parse(document.getElementById('rmeta')!.textContent!); const f = document.getElementById('rf') as HTMLFormElement; const msg = document.getElementById('rmsg')!;
      f.addEventListener('submit', async () => {
        const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
        if (!d.embodiment_id || !d.outcome) return; if (!d.evidence_url && !d.note) { msg.textContent = M.need; return; }
        msg.textContent = '…';
        try { const r = await fetch('https://compute.sinanlab.com/api/robo/repro', { method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ model_id: M.model_id, ...d }) }); const j = await r.json().catch(() => ({})); msg.textContent = r.ok ? M.ok : M.fail + (j.message || j.error || r.status); if (r.ok) f.reset(); }
        catch (e) { msg.textContent = M.fail + String(e); }
      });
    </script>
    <style>.rf{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.rf select,.rf input{padding:7px 9px;border:1px solid var(--hair-2);border-radius:8px;font:inherit;font-size:13px}.rf input[name=evidence_url]{min-width:260px;flex:1}.rf input[name=note]{min-width:220px;flex:1}</style>
  </section>
</Base>
