---
// 月报《开源 VLA 观察》：上半是脚本产出的数字（结构块），下半是署名分析。数字与分析分开，读者能看出哪句是数、哪句是判断。
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href, type Lang } from '../lib/i18n';
import { sections } from '../lib/md';
import { fmtMs } from '../lib/cost';
interface Props { lang: Lang; month: string }
const { lang, month } = Astro.props;
const en = lang === 'en';
const r = (await getCollection('reports')).map((x) => x.data as any).find((x) => x.month === month)!;
const S = r; const hw = Object.fromEntries((await getCollection('hardware')).map((h) => [h.data.id, h.data.name]));
const secs = sections((en ? r.analysis_en : r.analysis_zh) || '');
const title = secs.find((s) => s.key === 'title')?.title || (en ? `Open VLA Monthly · ${month}` : `开源 VLA 观察 · ${month}`);
const body = secs.filter((s) => s.key !== 'title');
const n = (v: any) => (v == null ? '—' : Number(v).toLocaleString('en-US'));
const T = en ? { eyebrow: 'Sinan Robo · monthly · numbers first, analysis second', back: 'All issues', block: 'Numbers (generated by script)', blockS: 'Every figure comes from this repository’s data files on the generation date; nothing below is estimated.', idx: 'Index', act: 'Activity', meas: 'Measurements', bench: 'Benchmark scores', ds: 'Datasets', analysis: 'Analysis (signed)', analysisS: 'Judgements by the maintainers. They are opinions grounded in the numbers above and are labelled as such.', models: 'models', cn: 'from Chinese organisations', lic: 'licence: commercial OK / not / unverified', size: 'by size: <1B / 1–4B / 4–8B / ≥8B', stale: 'repos with no push > 180 d', zero: 'repos with 0 commits in 90 d', dl: 'HF downloads, 30 d, top-3 share', mirrors: 'with a ModelScope mirror', total: 'measurements', month_m: 'added this month', recipes: 'recipes published', notrep: 'not reproduced', scores: 'scores', mws: 'models with a score', dsn: 'datasets', hours: 'hours stated', eps: 'episodes stated', dsm: 'with a China mirror', hwc: 'Hardware', model: 'Model', p50: 'p50 ms', p95: 'p95 ms', vram: 'VRAM', gen: 'generated' }
  : { eyebrow: 'Sinan Robo · 月报 · 先数字后分析', back: '全部月报', block: '数字（脚本生成）', blockS: '每个数字都来自生成当日本仓库的数据文件，下面没有任何估算。', idx: '索引', act: '活性', meas: '实测', bench: '基准分数', ds: '数据集', analysis: '分析（署名）', analysisS: '维护者的判断。它们是基于上面数字的观点，并被标注为观点。', models: '个模型', cn: '来自中国机构', lic: '许可证：可商用 / 禁商用 / 待核实', size: '按规模：<1B / 1–4B / 4–8B / ≥8B', stale: '个仓库超过 180 天无推送', zero: '个仓库近 90 天零提交', dl: 'HF 近 30 天下载，前三名占比', mirrors: '个有 ModelScope 镜像', total: '条实测', month_m: '本月新增', recipes: '篇配方', notrep: '未复现', scores: '条分数', mws: '个模型有分数', dsn: '个数据集', hours: '小时（已写明）', eps: '条轨迹（已写明）', dsm: '个有国内镜像', hwc: '硬件', model: '模型', p50: 'p50 ms', p95: 'p95 ms', vram: '显存', gen: '生成于' };
const I = S.index || {}, Ac = S.activity || {}, M = S.measurements || {}, B = S.benchmarks || {}, D = S.datasets || {};
---
<Base lang={lang} title={`${title} · Sinan Robo`} desc={secs.find((s) => s.key === 'summary')?.html.replace(/<[^>]+>/g, '').slice(0, 150) || title} active="reports" path={'/reports/' + month} crumbs={[{ label: T.back, href: href(lang, '/reports') }, { label: month }]}>
  <div class="rise" style="--i:0;margin-bottom:14px"><div class="eyebrow" style="color:var(--robo-deep);opacity:1">{T.eyebrow}</div><h1 style="font-size:28px;margin-top:6px">{title}</h1><p class="sub">{S.from} → {S.to} · {T.gen} {String(S.generated).slice(0, 10)}</p></div>

  <section class="card pad rise" style="--i:1"><h2 class="sec">{T.block}</h2><p class="sub" style="margin-top:4px">{T.blockS}</p>
    <div class="blk">
      <div><h3>{T.idx}</h3><ul><li><b>{I.models}</b> {T.models} · <b>{I.chinese_org}</b> {T.cn}</li><li>{T.lic}：<b>{I.license?.yes} / {I.license?.no} / {I.license?.unk}</b></li><li>{T.size}：<b>{I.size?.lt1} / {I.size?.b1_4} / {I.size?.b4_8} / {I.size?.ge8}</b></li></ul></div>
      <div><h3>{T.act}</h3><ul><li><b>{Ac.stale_180}</b> / {Ac.repos} {T.stale}</li><li><b>{Ac.zero_commits_90}</b> / {Ac.repos} {T.zero}</li><li>{T.dl}：<b>{Ac.dl30_top3_share != null ? Math.round(Ac.dl30_top3_share * 100) + '%' : '—'}</b>（{n(Ac.dl30_total)}）</li><li><b>{Ac.modelscope_mirrors}</b> {T.mirrors}</li></ul></div>
      <div><h3>{T.meas}</h3><ul><li><b>{M.total}</b> {T.total} · {T.month_m} <b>{M.this_month}</b></li><li><b>{M.recipes}</b> {T.recipes} · {T.notrep} <b>{(M.not_reproduced || []).length}</b></li></ul></div>
      <div><h3>{T.bench} · {T.ds}</h3><ul><li><b>{B.scores}</b> {T.scores} · <b>{B.models_with_score}</b> {T.mws}</li><li><b>{D.count}</b> {T.dsn} · <b>{n(D.hours_total)}</b> {T.hours} · <b>{n(D.episodes_total)}</b> {T.eps} · <b>{D.mirrors}</b> {T.dsm}</li></ul></div>
    </div>
    {M.by_hardware && Object.keys(M.by_hardware).length ? <div class="tablewrap" style="margin-top:12px"><table><thead><tr><th>{T.hwc}</th><th>{T.model}</th><th class="num">{T.p50}</th><th class="num">{T.p95}</th><th class="num">{T.vram}</th></tr></thead>
      <tbody>{Object.entries(M.by_hardware).flatMap(([h, rows]: any) => rows.map((x: any, i: number) => <tr><td>{i === 0 ? <a href={href(lang, '/hardware/' + h)}>{hw[h] || h}</a> : ''}</td><td><a href={href(lang, '/models/' + x.model_id)}>{x.name}</a></td><td class="num mono">{fmtMs(x.p50)}</td><td class="num mono">{fmtMs(x.p95)}</td><td class="num mono">{x.vram != null ? x.vram + ' GB' : '—'}</td></tr>))}</tbody></table></div> : null}
  </section>

  <section class="card pad rise prose" style="--i:2;margin-top:16px"><h2 class="sec">{T.analysis}</h2><p class="sub" style="margin-top:4px">{T.analysisS}</p>
    {body.length ? body.map((s) => <div class="an"><h3>{s.title}</h3><Fragment set:html={s.html} /></div>) : <div class="callout" style="margin-top:10px">{en ? 'Analysis for this issue is being written.' : '本期分析正在撰写。'}</div>}
  </section>
  <style>
    .blk{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 24px;margin-top:12px}@media (max-width:760px){.blk{grid-template-columns:1fr}}
    .blk h3{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);margin:0 0 6px}.blk ul{margin:0;padding-left:18px;font-size:13.5px;line-height:1.8}
    .an{margin-top:18px}.an h3{font-size:17px;margin:0 0 8px}.an p{font-size:14.5px;line-height:1.85;margin:0 0 10px}.an ul,.an ol{font-size:14px;line-height:1.8}.an blockquote{border-left:3px solid var(--robo-deep);padding-left:12px;color:var(--ink-3);margin:8px 0}.an table{font-size:13px}
  </style>
</Base>
