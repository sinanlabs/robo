---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, href, type Lang } from '../lib/i18n';
import { isUrl, hostOf } from '../lib/evidence';
import { liveRent } from '../lib/gpuledger';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const hw = (await getCollection('hardware')).map((h) => h.data);
const meas = (await getCollection('measurements')).map((m) => m.data);
const live = Object.fromEntries(await Promise.all(hw.map(async (h) => [h.id, await liveRent(h.id)])));
---
<Base lang={lang} title={t(lang, 'hardware.title') + ' · Sinan Robo'} active="hardware" path="/hardware" crumbs={[{ label: t(lang, 'nav.hardware') }]}>
  <div class="rise" style="--i:0;margin-bottom:14px"><h1 style="font-size:24px">{t(lang, 'hardware.title')}</h1><p class="lead">{t(lang, 'hardware.p')} {en ? 'Rental prices will be fed daily from the Sinan Compute price library once the GPU rental adapters are live.' : 'GPU 租赁采集器上线后，租价会每天从 Sinan Compute 价格库同步。'}</p></div>
  <div class="grid2" style="margin-top:0;grid-template-columns:repeat(2,1fr)">
    {hw.map((h, i) => { const n = meas.filter((m) => m.hardware_id === h.id).length; return (
      <a class="card tile rise" href={href(lang, '/hardware/' + h.id)} style={`--i:${i + 1}`}>
        <div class="v">{live[h.id] ? <span>¥{live[h.id].cny.toFixed(2)}<small style="font-size:13px;color:var(--ink-3);font-weight:500"> /h · ${live[h.id].usd.toFixed(2)}</small></span> : h.rental_cny_per_hour_ref != null ? <span>¥{h.rental_cny_per_hour_ref}<small style="font-size:13px;color:var(--ink-3);font-weight:500"> /h</small></span> : <span style="font-size:14px;color:var(--ink-3)">{en ? 'no rental price' : '暂无租价'}</span>}</div>
        <div class="k">{h.name}</div>
        <div class="n">{h.vram_gb != null ? h.vram_gb + ' GB' : '—'} · {h.type} · {n ? n + (en ? ' measurements' : ' 条测量') : (en ? 'no measurements yet' : '暂无测量')}</div>
        <div class="dim" style="margin-top:8px">{live[h.id] ? (en ? `Live: ${live[h.id].platform} · ${live[h.id].ts.slice(0, 10)} · Sinan Compute GPU ledger` : `实时：${live[h.id].platform} · ${live[h.id].ts.slice(0, 10)} · 来自 Sinan Compute 算力租赁账本`) : (h.rental_ref_source ? (en ? 'Ref: ' : '来源：') + h.rental_ref_source : '') + (isUrl(h.rental_ref_url) ? ' · ' + hostOf(h.rental_ref_url) : '')}</div>
      </a>); })}
  </div>
</Base>
