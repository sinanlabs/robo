---
// 月报列表：《开源 VLA 观察》各期。
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href, type Lang } from '../lib/i18n';
import { sections } from '../lib/md';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const reports = (await getCollection('reports')).map((x) => x.data as any).sort((a, b) => b.month.localeCompare(a.month));
const T = en ? { h1: 'Open VLA Monthly', lead: 'One issue a month. The first half is numbers generated by script from this site’s data files; the second half is signed analysis. Numbers and judgements are kept apart so you can tell which is which.', open: 'Read →', none: 'The first issue is being prepared.' }
  : { h1: '开源 VLA 观察 · 月报', lead: '每月一期。上半是脚本从本站数据文件生成的数字，下半是署名分析。数字与判断分开写，读者能分清哪句是数、哪句是观点。', open: '阅读 →', none: '创刊号正在准备。' };
---
<Base lang={lang} title={T.h1 + ' · Sinan Robo'} desc={T.lead} active="reports" path="/reports" crumbs={[{ label: T.h1 }]}>
  <div class="rise" style="--i:0;margin-bottom:14px"><h1 style="font-size:24px">{T.h1}</h1><p class="lead">{T.lead}</p></div>
  {reports.length === 0 && <div class="card pad"><div class="callout">{T.none}</div></div>}
  <div class="rp">{reports.map((r, i) => { const secs = sections((en ? r.analysis_en : r.analysis_zh) || ''); const title = secs.find((s) => s.key === 'title')?.title || `${T.h1} · ${r.month}`; const sum = secs.find((s) => s.key === 'summary')?.html.replace(/<[^>]+>/g, '') || ''; return (
    <a class="card pad rise" style={`--i:${1 + i * 0.3}`} href={href(lang, '/reports/' + r.month)}>
      <div class="eyebrow" style="color:var(--robo-deep);opacity:1">{r.month} · {r.from} → {r.to}</div><h2 style="font-size:20px;margin:6px 0 8px">{title}</h2>
      <p style="font-size:14px;line-height:1.7;margin:0">{sum.slice(0, 220)}{sum.length > 220 ? '…' : ''}</p>
      <div class="chips"><span>{en ? 'models' : '模型'} <b>{r.index?.models}</b></span><span>{en ? 'measurements' : '实测'} <b>{r.measurements?.total}</b></span><span>{en ? 'scores' : '分数'} <b>{r.benchmarks?.scores}</b></span><span>{en ? 'datasets' : '数据集'} <b>{r.datasets?.count}</b></span></div>
      <div style="margin-top:10px;font-size:13px;color:var(--robo-deep);font-weight:600">{T.open}</div>
    </a>); })}</div>
  <style>.rp{display:grid;gap:14px}.rp a{text-decoration:none;color:inherit;display:block}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.chips span{font-size:12px;border:1px solid var(--hair-2);border-radius:999px;padding:3px 10px;color:var(--ink-3)}.chips b{color:var(--ink);margin-left:4px}</style>
</Base>
