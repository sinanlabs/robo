---
// 部署配方总览：通用步骤（国内镜像 / 分组环境 / 权重下载）→ 环境坑位表 → 每个模型的配方 → 未复现清单。全部来自 bench/ 真正跑通的脚本与日志。
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { href, type Lang } from '../lib/i18n';
import { fmtMs } from '../lib/cost';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const models = (await getCollection('models')).map((m) => m.data);
const hw = (await getCollection('hardware')).map((h) => h.data);
const meas = (await getCollection('measurements')).map((m) => m.data).filter((m) => m.review_status !== 'rejected');
const recipes = (await getCollection('recipes')).map((r) => r.data as any);
const meta = ((await getCollection('recipes_meta')).map((r) => r.data as any)[0]) || { common: [], envs: [], not_reproduced: [] };
const byId: Record<string, any> = {}; for (const m of models) byId[m.id] = m;
const hwIds = Array.from(new Set(meas.map((m) => m.hardware_id)));
const hwOrder = hw.filter((h) => hwIds.includes(h.id));
const p50 = (mid: string, hid: string) => { const xs = meas.filter((m) => m.model_id === mid && m.hardware_id === hid).map((m) => m.metrics.latency_ms_p50).sort((a, b) => a - b); return xs.length ? xs[Math.floor(xs.length / 2)] : null; };
const T = en ? {
  h1: 'Deployment recipes', lead: 'Exact commands and version pins from the runs behind our latency measurements, on pay-as-you-go GPUs in China (AutoDL). Every step here was executed, every pitfall was hit and fixed. We publish only what actually ran; models we could not reproduce are listed with the reason.',
  common: 'Common steps (AutoDL, China)', commonS: 'Mirrors, environments and disk handling that apply to every model below.', envs: 'Environment matrix', envsS: 'Models pin conflicting transformers versions; keep one venv per group.',
  env: 'venv group', tf: 'transformers', torch: 'torch', extra: 'extra deps', models: 'models', list: 'Recipes', listS: 'One page per model: environment, weights, run command, pitfalls, measured latency.',
  weights: 'weights', pitfalls: 'pitfalls', notrep: 'Not reproduced (yet)', notrepS: 'Listed with the blocker. No latency numbers are published for these.', open: 'Open recipe →', machine: 'Machine',
} : {
  h1: '部署配方', lead: '我们做延迟实测时真正执行过的命令与版本号，机器是国内按量租的 GPU（AutoDL）。这里每一步都跑过，每个坑都踩过并修好。只发布真正跑通的步骤；没复现出来的模型单独列出原因。',
  common: '通用步骤（AutoDL，国内）', commonS: '镜像、分组环境、磁盘处理，下面每个模型都用得上。', envs: '环境坑位表', envsS: '不同模型钉的 transformers 版本互相冲突，一组一个 venv。',
  env: '环境组', tf: 'transformers', torch: 'torch', extra: '额外依赖', models: '模型', list: '配方', listS: '每个模型一页：环境、权重、运行命令、坑位、实测延迟。',
  weights: '权重', pitfalls: '个坑位', notrep: '尚未复现', notrepS: '列出卡在哪里。这些模型不发布任何延迟数字。', open: '查看配方 →', machine: '机器',
};
---
<Base lang={lang} title={T.h1 + ' · Sinan Robo'} desc={T.lead} active="recipes" path="/recipes" crumbs={[{ label: T.h1 }]}>
  <div class="rise" style="--i:0;margin-bottom:14px"><h1 style="font-size:24px">{T.h1}</h1><p class="lead">{T.lead}</p>
    {meta.machine && <p class="sub">{T.machine}：{meta.machine[en ? 'en' : 'zh']} · {meta.generated}</p>}</div>

  <section class="card pad rise" style="--i:1"><h2 class="sec">{T.common}</h2><p class="lead" style="margin-top:4px">{T.commonS}</p>
    <ol class="steps">{(meta.common || []).map((c: any) => (<li><div>{c[en ? 'en' : 'zh']}</div>{c.cmd && <pre><code>{c.cmd}</code></pre>}</li>))}</ol>
  </section>

  <section class="card rise" style="--i:2;margin-top:16px"><div class="pad" style="padding-bottom:10px"><h2 class="sec">{T.envs}</h2><p class="lead" style="margin-top:4px">{T.envsS}</p></div>
    <div class="tablewrap"><table><thead><tr><th>{T.env}</th><th>{T.tf}</th><th>{T.torch}</th><th>{T.extra}</th><th>{T.models}</th></tr></thead>
      <tbody>{(meta.envs || []).map((e: any) => (<tr><td class="mono"><b>{e.id}</b></td><td class="mono">{e.transformers}</td><td>{e.torch}</td><td class="mono" style="font-size:12.5px">{e.extra}</td><td>{e.models.map((id: string) => byId[id] ? <a href={href(lang, '/models/' + id)} style="margin-right:8px">{byId[id].name}</a> : <span class="mono" style="margin-right:8px">{id}</span>)}</td></tr>))}</tbody></table></div>
  </section>

  <section class="rise" style="--i:3;margin-top:16px"><h2 class="sec">{T.list}</h2><p class="lead" style="margin-top:4px;margin-bottom:10px">{T.listS}</p>
    <div class="rc">{recipes.map((r: any) => { const m = byId[r.model_id]; const gb = (r.weights || []).reduce((a: number, w: any) => a + (w.size_gb || 0), 0); return (
      <a class="card pad rcard" href={href(lang, '/recipes/' + r.model_id)}>
        <div class="eyebrow" style="color:var(--robo-deep);opacity:1">{m?.org}</div><h3>{m?.name ?? r.model_id}</h3>
        <div class="sub">venv <b class="mono">{r.env}</b> · {gb.toFixed(1)} GB {T.weights} · {(r.pitfalls || []).length} {T.pitfalls}</div>
        <div class="lat">{hwOrder.map((h) => { const v = p50(r.model_id, h.id); return <span><small>{h.name}</small><b class="mono">{v != null ? fmtMs(v) + ' ms' : '—'}</b></span>; })}</div>
        <div class="go">{T.open}</div>
      </a>); })}</div>
  </section>

  {(meta.not_reproduced || []).length > 0 && <section class="card pad rise" style="--i:4;margin-top:16px"><h2 class="sec">{T.notrep}</h2><p class="lead" style="margin-top:4px">{T.notrepS}</p>
    <ul class="nr">{meta.not_reproduced.map((x: any) => (<li><b>{byId[x.model_id] ? <a href={href(lang, '/models/' + x.model_id)}>{byId[x.model_id].name}</a> : x.model_id}</b> · {x[en ? 'en' : 'zh']}</li>))}</ul>
  </section>}
  <style>
    .steps{margin:12px 0 0;padding-left:22px;display:grid;gap:10px;font-size:14px;line-height:1.6}.steps pre{margin:6px 0 0;background:var(--bg-2,#f6f7fb);border:1px solid var(--hair-2);border-radius:10px;padding:8px 10px;font-size:12px;overflow:auto}
    .rc{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}.rcard{display:block;text-decoration:none;color:inherit}.rcard h3{margin:4px 0 6px;font-size:18px}
    .lat{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}.lat span{display:grid}.lat small{font-size:11px;color:var(--ink-3)}.lat b{font-size:14px}
    .go{margin-top:10px;font-size:13px;color:var(--robo-deep);font-weight:600}.nr{margin:10px 0 0;padding-left:18px;font-size:14px;line-height:1.8}
  </style>
</Base>
