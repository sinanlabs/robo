---
import '../styles/global.css';
import { t, href, switchPath, type Lang } from '../lib/i18n';
import { getCollection } from 'astro:content';

interface Props { lang: Lang; title: string; desc?: string; active?: string; path: string; crumbs?: { label: string; href?: string }[] }
const { lang, title, desc, active = '', path, crumbs } = Astro.props;
const site = 'https://robo.sinanlab.com';
const canonical = site + href(lang, path);
const altZh = site + href('zh-cn', path), altEn = site + href('en', path);
const models = await getCollection('models');
const embs = await getCollection('embodiments');
const description = desc ?? t(lang, 'site.desc');
const nav = [
  ['home', '/', '<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/>', ''],
  ['models', '/models', '<path d="M4 7h16M4 12h16M4 17h10"/>', String(models.length)],
  ['matrix', '/matrix', '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>', ''],
  ['embodiments', '/embodiments', '<circle cx="12" cy="5" r="2"/><path d="M12 7v5M7 22l5-10 5 10M5 12h14"/>', String(embs.length)],
  ['hardware', '/hardware', '<rect x="4" y="6" width="16" height="12" rx="2"/><path d="M8 10h8M8 14h5"/>', ''],
] as const;
const nav2 = [
  ['methodology', '/methodology', '<path d="M4 6h16M4 12h10M4 18h7"/>'],
  ['subscribe', '/subscribe', '<path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>'],
  ['about', '/about', '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>'],
] as const;
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="zh-CN" href={altZh}>
<link rel="alternate" hreflang="en" href={altEn}>
<link rel="alternate" hreflang="x-default" href={altZh}>
<meta property="og:site_name" content="Sinan Robo">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#050716">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<!-- Cloudflare Web Analytics 占位：上线后在此粘贴 beacon 片段（无 cookie） -->
</head>
<body>
<div class="app">
<aside class="rail">
  <a class="brand" href={href(lang, '/')}><span class="mark"></span><div><b>Sinan Robo</b><small>{lang === 'en' ? 'EMBODIED MODEL INDEX · SINAN LAB' : '司南·机脑 · SINAN LAB'}</small></div></a>
  <div class="sect">{lang === 'en' ? 'Index' : '索引'}</div>
  {nav.map(([k, p, ico, badge]) => (
    <a class={'nav' + (active === k ? ' on' : '')} href={href(lang, p)}><svg viewBox="0 0 24 24" set:html={ico}></svg>{t(lang, 'nav.' + k)}{badge && <span class="badge">{badge}</span>}</a>
  ))}
  <div class="sect">{lang === 'en' ? 'Foundations' : '底层'}</div>
  {nav2.map(([k, p, ico]) => (
    <a class={'nav' + (active === k ? ' on' : '')} href={href(lang, p)}><svg viewBox="0 0 24 24" set:html={ico}></svg>{t(lang, 'nav.' + k)}</a>
  ))}
  <a class="xlink" href="https://compute.sinanlab.com"><span class="gl"></span><b>Sinan Compute</b><p>{lang === 'en' ? 'GPU & model API price and quality measurement' : 'GPU 与模型 API 的中立比价与质量测量'}</p></a>
</aside>
<div class="main">
  <div class="top">
    <div class="crumb"><a href="https://sinanlab.com">{t(lang, 'nav.lab')}</a>{crumbs && crumbs.map((c) => (<span> › {c.href ? <a href={c.href}>{c.label}</a> : c.label}</span>))}</div>
    <div class="right"><a class="lang" href={switchPath(lang, Astro.url.pathname)}>{t(lang, 'lang.switch')}</a></div>
  </div>
  <slot />
  <footer class="ft"><div class="in">
    <span>{t(lang, 'footer.copy')}</span>
    <a href="https://sinanlab.com/constitution">{t(lang, 'footer.constitution')}</a>
    <a href="https://sinanlab.com/disclosure">{t(lang, 'footer.disclosure')}</a><a href="https://github.com/sinanlabs/robo" rel="noopener">GitHub</a>
    <a href="https://sinanlab.com/privacy">{t(lang, 'footer.privacy')}</a>
    <a href="https://sinanlab.com/disclaimer">{t(lang, 'footer.disclaimer')}</a>
    <a href="https://sinanlab.com/">{t(lang, 'footer.mother')}</a>
    <a href="mailto:hello@sinanlab.com">hello@sinanlab.com</a>
    <span style="margin-left:auto">{t(lang, 'footer.line')}</span>
  </div></footer>
</div>
</div>
</body>
</html>
